  showTokenUsage: true
  shimmer: classic
  hideToolActivity: false
dev: 
  autoqaConsent: denied
modelRoles: 
  default: opencode-zen/deepseek-v4-pro
disabledProviders: 
  - opencode
  - opencode-go
github: 
  enabled: true