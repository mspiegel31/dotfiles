{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "slack-official": {
      "type": "http",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "2544636386.9731046712775",
        "redirectUri": "http://127.0.0.1:19876/mcp/oauth/callback"
      }
    },
    "cloudflare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp",
      "oauth": {}
    },
    "cloudflare-docs": {
      "type": "http",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
{{- if eq .chezmoi.hostname .workHostname }}
    "aws-knowledge": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws",
      "enabled": true
    },
    "lucid": {
      "type": "http",
      "url": "https://mcp.lucid.app/mcp"
    },
{{- end }}
    "google-workspace": {
      "command": "uvx",
      "args": [
        "workspace-mcp",
        "--single-user",
        "--permissions",
        "docs:readonly",
        "drive:readonly",
        "--tool-tier",
        "complete"
      ],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "!cat $HOME/.config/agent-secrets/google-workspace-client-id",
        "GOOGLE_OAUTH_CLIENT_SECRET": "!cat $HOME/.config/agent-secrets/google-workspace-client-secret",
        "USER_GOOGLE_EMAIL": "mspiegel@spoton.com",
        "OAUTHLIB_INSECURE_TRANSPORT": "1"
      }
    },
    "repomix": {
      "command": "bunx",
      "args": [
        "repomix",
        "--mcp"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{{ (bitwardenSecrets "a8816ec9-9a7c-475c-9a69-b4a000a1077b" .accessToken).value }}"
      }
    },
    "chrome-devtools": {
      "command": "bunx",
      "args": [
        "chrome-devtools-mcp@latest"
      ]
    },
    "karakeep": {
      "command": "npx",
      "args": [
        "-y",
        "@karakeep/mcp"
      ],
      "env": {
        "KARAKEEP_API_ADDR": "https://karakeep.electricgarage.net/",
        "KARAKEEP_API_KEY": "{{ (bitwardenSecrets "09769377-d6fa-48f6-9c2d-b4a000a02dad" .accessToken).value }}"
      }
    },
    "rovo": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "grafana-mcp-server": {
      "command": "tsh",
      "args": [
        "mcp",
        "connect",
        "grafana-mcp-server"
      ],
      "env": {
        "TELEPORT_CLUSTER": "ue1-staging"
      }
    },
    "backstage": {
      "type": "http",
      "url": "https://backstage.spoton.com/api/mcp-actions/v1/infra-context"
    },
    "gitops-local-mcp": {
      "type": "http",
      "url": "http://localhost:7007/api/mcp-actions/v1/gitops",
      "headers": {
        "Authorization": "!printf 'Bearer %s' \"$(cat $HOME/.config/agent-secrets/gitops-local-token)\""
      },
      "enabled": true
    },
    "spoton-mcp": {
      "type": "http",
      "url": "https://ai.spoton.com/mcp"
    }
  }
}
