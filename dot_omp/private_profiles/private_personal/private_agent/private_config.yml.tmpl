{{ template "omp/config-base.yml.tmpl" . }}
modelRoles:
  advisor: openai-codex/gpt-5.6-terra:auto
  default: openai-codex/gpt-5.6-sol
  plan: openai-codex/gpt-5.6-sol:auto
  task: opencode-zen/nemotron-3-ultra-free
  smol: openai-codex/gpt-5.6-luna:auto
  local: litellm/qwen3.8-27b-nvfp4:medium
  tiny: litellm/qwen3.8-27b-nvfp4:low
disabledProviders:
  - opencode
  - opencode-go
  - omlx
  - ollama
  - llama.cpp
  - lm-studio
  - llama-swap
  - openrouter
task:
  isolation:
    enabled: true
  agentModelOverrides:
    sonic: "@local"
    scout: "@local"
    task: "@local"
  disabledAgents:
    []
retry:
  fallbackChains:
    tiny:
      - openai-codex/gpt-5.6-luna
codexResets:
  autoRedeem: "yes"
