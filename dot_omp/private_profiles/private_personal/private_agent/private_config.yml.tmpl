{{ template "omp/config-base.yml.tmpl" . }}
extensions:
  - "{{ .chezmoi.homeDir }}/.omp/agent/extensions/herdr-omp-agent-state.ts"
plan:
  enabled: true
  autosave: true
  autosaveDir: ~/plans
modelRoles:
  advisor: openai-codex/gpt-5.6-terra:auto
  default: openai-codex/gpt-5.6-sol
  plan: openai-codex/gpt-6-astra:auto
  task: openai-codex/gpt-5.6-luna:auto
  smol: openai-codex/gpt-5.6-luna:auto
  local: litellm/qwen3.8-27b-nvfp4:medium
  tiny: litellm/qwen3.8-27b-nvfp4:low
  slow: openai-codex/gpt-6-astra:auto
disabledProviders:
  - opencode
  - opencode-go
  - omlx
  - ollama
  - llama.cpp
  - lm-studio
  - llama-swap
  - openrouter
task:
  isolation:
    enabled: true
  agentModelOverrides:
    sonic: "@local"
    scout: "@local"
    task: "@local"
  disabledAgents:
    []
retry:
  fallbackChains:
    tiny:
      - openai-codex/gpt-5.6-luna
codexResets:
  autoRedeem: "yes"
