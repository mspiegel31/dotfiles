eval "$(pyenv init -)"
export PATH="$HOME/.local/bin:$PATH"


alias aws-whoami='aws --no-cli-pager sts get-caller-identity'
alias spotonlogin="aws ecr get-login-password --profile default | docker login --username AWS --password-stdin 656168747096.dkr.ecr.us-east-1.amazonaws.com"
alias fab="docker run --rm -it -v $HOME/development/production/spoton2:/spoton2 -e AWS_KEY=$FAB_AWS_KEY -e AWS_SECRET=$FAB_AWS_SECRET spoton2-fabric:latest"
alias nproc="sysctl -n hw.logicalcpu"
alias screenshots="open ~/Desktop/screenshots"

# Teleport
export TELEPORT_PROXY=tele.spoton.sh:443
export TELEPORT_AUTH=okta

# Chamber (segmentio/chamber) reads/writes SSM params encrypted with this KMS key.
export CHAMBER_KMS_KEY_ALIAS=aws/ssm

# kubeswitch: https://github.com/danielfoehrKn/kubeswitch/blob/master/docs/installation.md#zsh
# `switcher init` defines the `switch` shell function, so completion must load after it.
if command -v switcher &>/dev/null; then
  source <(switcher init zsh)
  source <(switch completion zsh)
  alias s=switch
fi