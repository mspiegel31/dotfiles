    "slack-official": {
      "type": "http",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "2544636386.9731046712775",
        "redirectUri": "http://127.0.0.1:19876/mcp/oauth/callback"
      }
    },
    "aws-knowledge": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws",
      "enabled": true
    },
    "lucid": {
      "type": "http",
      "url": "https://mcp.lucid.app/mcp"
    },
    "rovo": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "grafana-mcp-server": {
      "command": "node",
      "args": [
        "{{ .chezmoi.homeDir }}/.omp/profiles/work/agent/bin/grafana-mcp-proxy.mjs"
      ],
      "env": {
        "TELEPORT_CLUSTER": "ue1-staging",
        "GRAFANA_MCP_PORT": "8888"
      }
    },
    "backstage": {
      "type": "http",
      "url": "https://backstage.spoton.com/api/mcp-actions/v1/infra-context"
    },
    "backstage-gitops": {
      "type": "http",
      "url": "https://backstage.spoton.com/api/mcp-actions/v1/gitops"
    },
    "gitops-local-mcp": {
      "type": "http",
      "url": "http://localhost:7007/api/mcp-actions/v1/gitops",
      "headers": {
        "Authorization": "!printf 'Bearer %s' \"$(cat $HOME/.config/agent-secrets/gitops-local-token)\""
      },
      "enabled": true
    },
    "spoton-mcp": {
      "type": "http",
      "url": "https://ai.spoton.com/mcp"
    },
    "google-workspace": {
      "command": "uvx",
      "args": [
        "workspace-mcp",
        "--single-user",
        "--permissions",
        "docs:readonly",
        "drive:readonly",
        "--tool-tier",
        "complete"
      ],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "!cat $HOME/.config/agent-secrets/google-workspace-client-id",
        "GOOGLE_OAUTH_CLIENT_SECRET": "!cat $HOME/.config/agent-secrets/google-workspace-client-secret",
        "USER_GOOGLE_EMAIL": "mspiegel@spoton.com",
        "OAUTHLIB_INSECURE_TRANSPORT": "1"
      }
    },
