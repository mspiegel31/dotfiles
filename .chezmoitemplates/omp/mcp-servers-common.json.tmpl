    "cloudflare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp",
      "oauth": {}
    },
    "cloudflare-docs": {
      "type": "http",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "repomix": {
      "command": "bunx",
      "args": [
        "repomix",
        "--mcp"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{{ (bitwardenSecrets "a8816ec9-9a7c-475c-9a69-b4a000a1077b" .accessToken).value }}"
      }
    },
    "chrome-devtools": {
      "command": "bunx",
      "args": [
        "chrome-devtools-mcp@latest"
      ]
    },
    "karakeep": {
      "command": "npx",
      "args": [
        "-y",
        "@karakeep/mcp"
      ],
      "env": {
        "KARAKEEP_API_ADDR": "https://karakeep.electricgarage.net/",
        "KARAKEEP_API_KEY": "{{ (bitwardenSecrets "09769377-d6fa-48f6-9c2d-b4a000a02dad" .accessToken).value }}"
      }
    },
    "liftosaur": {
      "type": "http",
      "url": "https://www.liftosaur.com/mcp",
      "headers": {
        "Authorization": "Bearer {{ (bitwardenSecrets "e74bf7fe-a63f-4095-a37a-b4a901276ddd" .accessToken).value }}"
      }
    }
