<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.herdr.cwd-watcher</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Users/mike/.config/herdr/cwd-watcher.sh</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>

	<!-- Start on login, and restart if it ever exits (crash or otherwise). -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>

	<!-- Back off if it's crash-looping instead of hammering the CPU. -->
	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>StandardOutPath</key>
	<string>/Users/mike/.config/herdr/cwd-watcher.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/mike/.config/herdr/cwd-watcher.log</string>
</dict>
</plist>
