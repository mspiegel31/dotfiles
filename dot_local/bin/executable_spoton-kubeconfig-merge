#!/usr/bin/env python3
"""Atomically merge kubeconfig fragments into one native kubeconfig."""

from __future__ import annotations

import argparse
import fcntl
import json
import os
from pathlib import Path
import stat
import subprocess
import sys
import tempfile
from typing import Any


COLLECTIONS = ("clusters", "users", "contexts")


class MergeError(RuntimeError):
    pass


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Merge kubeconfig fragments while preserving the destination current-context."
    )
    parser.add_argument("--dry-run", action="store_true", help="validate and report without writing")
    parser.add_argument("destination", type=Path)
    parser.add_argument("sources", nargs="+", type=Path)
    return parser.parse_args()


def checked_file(path: Path, *, allow_missing: bool = False) -> Path:
    path = path.expanduser()
    if path.is_symlink():
        raise MergeError(f"refusing symbolic link: {path}")
    if not path.exists():
        if allow_missing:
            return path
        raise MergeError(f"kubeconfig does not exist: {path}")
    if not path.is_file():
        raise MergeError(f"kubeconfig is not a regular file: {path}")
    return path


def load_kubeconfig(path: Path) -> dict[str, Any]:
    process = subprocess.run(
        ["kubectl", "--kubeconfig", str(path), "config", "view", "--raw", "-o", "json"],
        text=True,
        capture_output=True,
        check=False,
    )
    if process.returncode != 0:
        detail = process.stderr.strip() or process.stdout.strip() or "kubectl failed"
        raise MergeError(f"cannot read {path}: {detail}")
    try:
        config = json.loads(process.stdout)
    except json.JSONDecodeError as error:
        raise MergeError(f"kubectl returned invalid JSON for {path}: {error}") from error
    if config.get("kind") != "Config" or config.get("apiVersion") != "v1":
        raise MergeError(f"not a v1 kubeconfig: {path}")
    return config


def named_entries(config: dict[str, Any], collection: str, path: Path) -> list[dict[str, Any]]:
    entries = config.get(collection, []) or []
    if not isinstance(entries, list):
        raise MergeError(f"{path}: {collection} is not a list")
    names: set[str] = set()
    for entry in entries:
        name = entry.get("name") if isinstance(entry, dict) else None
        if not isinstance(name, str) or not name:
            raise MergeError(f"{path}: {collection} contains an unnamed entry")
        if name in names:
            raise MergeError(f"{path}: duplicate {collection} entry: {name}")
        names.add(name)
    return entries


def merge_configs(
    destination: dict[str, Any],
    sources: list[tuple[Path, dict[str, Any]]],
) -> tuple[dict[str, Any], dict[str, dict[str, int]]]:
    merged = {
        "apiVersion": "v1",
        "kind": "Config",
        "preferences": destination.get("preferences", {}) or {},
        "current-context": destination.get("current-context", "") or "",
    }
    stats = {name: {"added": 0, "updated": 0, "unchanged": 0} for name in COLLECTIONS}

    for collection in COLLECTIONS:
        destination_entries = named_entries(destination, collection, Path("destination"))
        by_name = {entry["name"]: entry for entry in destination_entries}
        order = [entry["name"] for entry in destination_entries]
        for path, source in sources:
            for entry in named_entries(source, collection, path):
                name = entry["name"]
                if name not in by_name:
                    order.append(name)
                    stats[collection]["added"] += 1
                elif by_name[name] == entry:
                    stats[collection]["unchanged"] += 1
                else:
                    stats[collection]["updated"] += 1
                by_name[name] = entry
        merged[collection] = [by_name[name] for name in order]

    extensions = destination.get("extensions")
    if extensions:
        merged["extensions"] = extensions
    validate_references(merged)
    return merged, stats


def validate_references(config: dict[str, Any]) -> None:
    cluster_names = {entry["name"] for entry in config["clusters"]}
    user_names = {entry["name"] for entry in config["users"]}
    for entry in config["contexts"]:
        context = entry.get("context", {})
        cluster = context.get("cluster")
        user = context.get("user")
        if cluster and cluster not in cluster_names:
            raise MergeError(f"context {entry['name']} references missing cluster {cluster}")
        if user and user not in user_names:
            raise MergeError(f"context {entry['name']} references missing user {user}")


def render_kubeconfig(config: dict[str, Any], directory: Path) -> bytes:
    with tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=directory, prefix=".kubeconfig-input.", delete=False
    ) as temporary:
        input_path = Path(temporary.name)
        os.chmod(input_path, stat.S_IRUSR | stat.S_IWUSR)
        json.dump(config, temporary)
        temporary.flush()
        os.fsync(temporary.fileno())
    try:
        process = subprocess.run(
            [
                "kubectl",
                "--kubeconfig",
                str(input_path),
                "config",
                "view",
                "--raw",
                "--flatten",
                "-o",
                "yaml",
            ],
            capture_output=True,
            check=False,
        )
        if process.returncode != 0:
            detail = process.stderr.decode(errors="replace").strip() or "kubectl failed"
            raise MergeError(f"cannot render merged kubeconfig: {detail}")
        return process.stdout
    finally:
        input_path.unlink(missing_ok=True)


def write_atomic(destination: Path, content: bytes) -> None:
    destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if destination.parent.is_symlink():
        raise MergeError(f"refusing symbolic-link directory: {destination.parent}")
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{destination.name}.", dir=destination.parent)
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, stat.S_IRUSR | stat.S_IWUSR)
        with os.fdopen(descriptor, "wb") as output:
            output.write(content)
            output.flush()
            os.fsync(output.fileno())
        load_kubeconfig(temporary)
        os.replace(temporary, destination)
    finally:
        if temporary.exists():
            temporary.unlink()


def format_stats(stats: dict[str, dict[str, int]], *, dry_run: bool) -> str:
    action = "Would merge" if dry_run else "Merged"
    details = ", ".join(
        f"{collection}: +{counts['added']} ~{counts['updated']} ={counts['unchanged']}"
        for collection, counts in stats.items()
    )
    return f"{action} kubeconfigs ({details})"


def main() -> int:
    args = parse_args()
    try:
        destination = checked_file(args.destination, allow_missing=True)
        sources = [checked_file(path) for path in args.sources]
        destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        lock_path = destination.with_name(f".{destination.name}.spoton-merge.lock")
        with lock_path.open("a+b") as lock:
            os.chmod(lock_path, stat.S_IRUSR | stat.S_IWUSR)
            fcntl.flock(lock, fcntl.LOCK_EX)
            checked_file(destination, allow_missing=True)
            base = load_kubeconfig(destination) if destination.exists() else {
                "apiVersion": "v1",
                "kind": "Config",
                "preferences": {},
                "clusters": [],
                "users": [],
                "contexts": [],
                "current-context": "",
            }
            source_configs = [(path, load_kubeconfig(path)) for path in sources]
            merged, stats = merge_configs(base, source_configs)
            rendered = render_kubeconfig(merged, destination.parent)
            if not args.dry_run:
                write_atomic(destination, rendered)
        print(format_stats(stats, dry_run=args.dry_run))
        return 0
    except (MergeError, OSError) as error:
        print(f"spoton-kubeconfig-merge: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
