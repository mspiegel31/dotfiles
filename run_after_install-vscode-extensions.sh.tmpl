#!/bin/sh
set -eu

if ! command -v code >/dev/null 2>&1; then
  printf '%s\n' 'VS Code CLI not found; skipping extension installation.' >&2
  exit 0
fi

while IFS= read -r extension; do
  case "$extension" in ''|'#'*) continue ;; esac
  if ! code --install-extension "$extension"; then
    printf '%s\n' "Unable to install VS Code extension: $extension" >&2
  fi
done <<'EXTENSIONS'
{{ include ".chezmoitemplates/vscode-extensions.list" }}
EXTENSIONS
