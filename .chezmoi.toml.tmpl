# Rendered by `chezmoi init` into ~/.config/chezmoi/chezmoi.toml. This repository
# lives outside chezmoi's default ~/.local/share/chezmoi, so sourceDir has to be
# recorded here for every later `chezmoi` invocation to find the source state.
sourceDir = {{ .chezmoi.sourceDir | quote }}

[bitwardenSecrets]
command = "bws"

[git]
autoPush = true

[merge]
command = "bash"
args = [
  "-c",
  {{ printf "%q" `cp {{ .Target | quote }} {{ printf "%s.base" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf "%s.base" .Target | quote }} {{ .Source | quote }}` }}
]

[data]
accessToken = {{ index . "accessToken" | default "" | quote }}
