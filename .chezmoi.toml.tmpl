# Rendered by `chezmoi init` into ~/.config/chezmoi/chezmoi.toml. This repository
# lives outside chezmoi's default ~/.local/share/chezmoi, so sourceDir has to be
# recorded here for every later `chezmoi` invocation to find the source state.
sourceDir = {{ .chezmoi.sourceDir | quote }}

[bitwardenSecrets]
command = "bws"

# `chezmoi diff` streams the builtin unified diff through hunk's pager mode,
# which opens hunk's full multi-file review UI (sidebar navigation across
# the whole changeset) directly -- no extra flags needed.
[diff]
pager = "hunk pager"

[git]
autoPush = true

# Chezmoi's merge state is 3-way: .Destination (live file on disk), .Source
# (the template in this repo), .Target (rendered output of .Source -- what
# chezmoi wants the destination to become). `chezmoi merge` and
# `chezmoi apply --interactive` (answering `m`) invoke this; plain apply,
# diff, and status never do.
#
# VS Code's `--merge` only draws the 3-way merge editor with 4 file handles
# (path1, path2, base, result), so a fake base is synthesized by copying
# .Target to .Target.base before invoking `code`. Recipe verbatim from
# https://www.chezmoi.io/user-guide/tools/merge/#use-vscode-as-the-merge-tool.
# `--disable-workspace-trust` is added because `--merge` opens loose temp
# files with no folder open, so VS Code has no trusted workspace to attach
# to and defaults every window to Restricted Mode -- which disables the
# merge editor's accept/reject controls. The flag is undocumented (absent
# from `code --help`) but accepted without a warning, unlike a genuinely
# unknown flag; it force-trusts the window instead of prompting.
#
# path1 = .Destination (live file), path2 = .Target (rendered desired
# state), base = .Target.base (copy of .Target, exists only to make VS Code
# draw the 3-way UI), result = .Source -- VS Code writes the merge result
# there on save+close, which is the file that actually persists.
[merge]
command = "bash"
args = [
  "-c",
  {{ printf "%q" "cp {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} && code --disable-workspace-trust --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} {{ .Source | quote }}" }},
]

[data]
accessToken = {{ index . "accessToken" | default "" | quote }}
